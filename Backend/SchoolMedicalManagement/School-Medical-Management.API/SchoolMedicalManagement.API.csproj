<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>School_Medical_Management.API</RootNamespace>
    <SpaRoot>..\..\..\Frontend\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.20" />
    <PackageReference Include="Hangfire.MemoryStorage" Version="1.8.1.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolMedicalManagement.Service\SchoolMedicalManagement.Service.csproj" />
  </ItemGroup>

  <Target Name="BuildFrontendForSingleFile"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(Configuration)' == 'Release' and '$(PublishSingleFile)' == 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory
      SourceDirectory="$(SpaRoot)dist"
      DestinationFile="$(IntermediateOutputPath)eduhealth-frontend.zip"
      Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)eduhealth-frontend.zip">
        <LogicalName>EduHealth.Frontend.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

  <Target Name="BuildFrontendForReleaseAssets"
          BeforeTargets="PrepareResourceNames;ComputeFilesToPublish"
          Condition="'$(Configuration)' == 'Release'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <FrontendDist Include="$(SpaRoot)dist\**\*" />

      <!-- Keep normal folder publish behavior working too. -->
      <ResolvedFileToPublish Include="@(FrontendDist->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
